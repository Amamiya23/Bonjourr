{
    "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
    "workspace": ["./worker"],
    "tasks": {
        "build": "deno run --allow-all ./tasks/build.ts",
        "edge": "deno run --allow-all ./tasks/build.ts edge dev",
        "chrome": "deno run --allow-all ./tasks/build.ts chrome dev",
        "firefox": "deno run --allow-all ./tasks/build.ts firefox dev",
        "online": "deno run --allow-all ./tasks/build.ts online dev",
        "serve": "deno run --allow-net --allow-read ./tasks/serve.ts 8000",
        "cloud:build": "deno task build online",
        "cloud:types": "npx --yes wrangler@4.151.2 types worker-configuration.d.ts --env-interface CloudflareEnv",
        "cloud:dev": "npx --yes wrangler@4.151.2 dev --port 8787",
        "cloud:migrate": "npx --yes wrangler@4.151.2 d1 migrations apply bonjourr-cloud --remote",
        "cloud:deploy": "npx --yes wrangler@4.151.2 deploy",
        "cloud:account": "deno run --allow-read=.cloud --allow-write=.cloud --allow-net ./tasks/account-setup.ts",
        "cloud:secrets": "deno run --allow-read=.cloud --allow-write=.cloud ./tasks/cloud-secrets.ts",
        "test": "deno test --allow-read --allow-env --reporter=dot",
        "types": "deno check src/ tasks/ tests/ && deno check --config worker/deno.json --sloppy-imports worker/index.ts worker/webdav.test.ts worker/database.test.ts",
        "format": "deno fmt",
        "app": "docker compose -f docker/compose.yaml up",
        "archive": "deno task archive:build && deno task archive:run",
        "archive:run": "docker run --rm -v ./release:/release bonjourr-archive",
        "archive:build": "docker build -f docker/archive/Dockerfile -t bonjourr-archive ."
    },
    "imports": {
        "@happy-dom/global-registrator": "npm:@happy-dom/global-registrator@20.0.11",
        "@std/assert": "jsr:@std/assert@^1.0.19",
        "@std/fs": "jsr:@std/fs@^1.0.24",
        "@types/firefox-webext-browser": "npm:@types/firefox-webext-browser@^143.0.0",
        "@types/chrome": "npm:@types/chrome@^0.1.43",
        "@victr/deepmerge": "npm:@victr/deepmerge@^1.3.2",
        "clickdown": "npm:clickdown@^1.3.4",
        "esbuild": "npm:esbuild@^0.28.0",
        "fake-indexeddb": "npm:fake-indexeddb@^6.2.5",
        "happy-dom": "npm:happy-dom@20.0.11",
        "prism-code-editor": "npm:prism-code-editor@^5.2.0"
    },
    "nodeModulesDir": "auto",
    "lint": {
        "include": [
            "src",
            "tasks",
            "tests",
            "_locales",
            "worker",
            "wrangler.jsonc"
        ],
        "rules": {
            "tags": [
                "recommended"
            ],
            "include": [
                "eqeqeq",
                "explicit-function-return-type",
                "verbatim-module-syntax",
                "single-var-declarator",
                "no-eval",
                "no-sparse-arrays",
                "no-inferrable-types",
                "no-external-import",
                "no-const-assign",
                "default-param-last"
            ]
        }
    },
    "fmt": {
        "indentWidth": 4,
        "lineWidth": 120,
        "useTabs": false,
        "semiColons": false,
        "singleQuote": true,
        "include": [
            "src",
            "tasks",
            "tests",
            "_locales"
        ],
        "exclude": ["**/overview.md"]
    },
    "compilerOptions": {
        "strict": true,
        "lib": [
            "dom",
            "dom.iterable",
            "dom.asynciterable",
            "deno.ns"
        ],
        "types": [
            "@types/firefox-webext-browser",
            "@types/chrome"
        ]
    }
}
